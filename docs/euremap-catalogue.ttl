    foaf:page <https://www.ebi.ac.uk/metagenomics> ;
    eur:acceptsInput res:mat-raw-reads ;
    eur:accessConditions "Free; raw reads submission to ENA (EMBL-EBI) required"@en ;
    eur:atPipelineStep res:step-genomics ;
    eur:deliveredByUnit res:unit-embl-ebi-mgnify-at-embl-ebi ;
    eur:hasAccessMode res:access-virtual ;
    eur:hasCapability res:cap-mag-binning,
        res:cap-metagenome-assembly,
        res:cap-taxonomic-classification ;
    eur:hasFeeModel res:fee-free ;
    eur:listedIn res:catalogue-euremap ;
    eur:offeredThrough res:ri-embl ;
    eur:providedBy res:org-embl-ebi ;
    eur:requiresPriorContact false ;
    eur:requiresSubmissionTo res:repo-ena ;
    eur:usesSoftware res:sw-mgnify .

res:service-EUREMAP_003 a dcat:DataService,
        eur:Service ;
    dct:description "Platform for the prediction, exploration and analysis of BGCs from metagenomic datasets.The service includes an analysis pipeline, a large searchable database, a user-friendly data portal, and tools that enable both scientists and developers to access and analyse the data."@en ;
    dct:identifier "EUREMAP_003" ;
    dct:source <https://services.euremap.eu/service/euremap_003/> ;
    dct:title "Prediction, exploration and analysis of biosynthetic gene clusters from metagenomic datasets"@en ;
    dcat:landingPage <https://services.euremap.eu/service/euremap_003/> ;
    foaf:page <https://www.ebi.ac.uk/finn-srv/mgnify-bgcs> ;
    eur:acceptsInput res:mat-raw-reads ;
    eur:accessConditions "Free; raw reads submission to ENA (EMBL-EBI) required"@en ;
    eur:atPipelineStep res:step-genomics ;
    eur:deliveredByUnit res:unit-embl-ebi-mgnify-at-embl-ebi ;
