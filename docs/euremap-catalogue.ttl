    eur:providedBy res:org-embl-ebi ;
    eur:requiresPriorContact false ;
    eur:requiresSubmissionTo res:repo-ena ;
    eur:usesSoftware res:sw-mgnify .

res:service-EUREMAP_004 a eur:Service ;
    dct:description "Metagenomics assembly and analysis pipeline including short-read, long-read and hybrid assembly, functional and taxonomic annotation, MAG generation and connected analysis, and primary analysis of prokaryotic genomes."@en ;
    dct:identifier "EUREMAP_004" ;
    dct:source <https://services.euremap.eu/service/euremap_004/> ;
    dct:title "Illumina and ONT sequencing with metagenome assembly, annotation, and genome analysis"@en ;
