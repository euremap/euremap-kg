res:service-EUREMAP_007 a eur:Service ;
    dct:description "Cultivation of microorganisms for biomass production, including all types of bacteria, including anaerobes, and fungi. This service includes culture scale-up to volumes of up to 50 L."@en ;
    dct:identifier "EUREMAP_007" ;
