res:dataset-euremap-kg a dcat:Dataset,
        prov:Entity ;
    dct:conformsTo <https://w3id.org/euremap/ontology> ;
    dct:description "Generated from the public catalogue listing and the 71 service detail pages retrieved on 2026-11-19. Capability tags are assigned by controlled keyword matching; national nodes are derived from service affiliations. Personal contact e-mails are intentionally not included."@en ;
    dct:issued "2026-11-19"^^xsd:date ;
    dct:title "EUREMAP service knowledge graph (instance data)"@en ;
    prov:wasDerivedFrom res:catalogue-euremap .

res:service-EUREMAP_001 a dcat:DataService,
        eur:Service ;
    dct:description "Assembly and analysis of raw DNA sequencing reads from environmental or biological samples to identify which organisms are present and what functions they may perform. The service includes quality control, taxonomic classification, gene prediction, and functional annotation using trusted databases. Results can reveal biological pathways, biosynthetic potential for natural product production, and other functional insights."@en ;
    dct:identifier "EUREMAP_001" ;
    dct:source <https://services.euremap.eu/service/euremap_001/> ;
    dct:title "Metagenomic read assembly with taxonomic and functional assignments"@en ;
    dcat:landingPage <https://services.euremap.eu/service/euremap_001/> ;
    foaf:page <https://www.ebi.ac.uk/metagenomics> ;
    eur:acceptsInput res:mat-raw-reads ;
    eur:accessConditions "Free; raw reads submission to ENA (EMBL-EBI) required"@en ;
    eur:atPipelineStep res:step-genomics ;
    eur:deliveredByUnit res:unit-embl-ebi-mgnify-at-embl-ebi ;
    eur:hasAccessMode res:access-virtual ;
    eur:hasCapability res:cap-functional-annotation,
        res:cap-gene-prediction,
        res:cap-metagenome-assembly,
        res:cap-taxonomic-classification ;
    eur:hasFeeModel res:fee-free ;
    eur:listedIn res:catalogue-euremap ;
    eur:offeredThrough res:ri-embl ;
    eur:providedBy res:org-embl-ebi ;
    eur:requiresPriorContact false ;
    eur:requiresSubmissionTo res:repo-ena ;
    eur:usesSoftware res:sw-mgnify .

res:service-EUREMAP_002 a dcat:DataService,
        eur:Service ;
    dct:description "Metagenome Assembled Genomes (MAGs) generation and analysis pipeline. The service includes quality assessment of recovered genomes and determination of their taxonomic origin."@en ;
    dct:identifier "EUREMAP_002" ;
    dct:source <https://services.euremap.eu/service/euremap_002/> ;
    dct:title "MAG generation and analysis with quality assessment and taxonomic assignment"@en ;
