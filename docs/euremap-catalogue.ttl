res:service-EUREMAP_008 a eur:Service ;
    dct:description "Production of microbial biomass from cultured strains under aerobic conditions in different formats using a suite of INFORS automated bioreactors ranging from 0.5 to 2 L, including four photobioreactors. This service includes scale-up to 10 L through continuous to semi-continuous cultivation, as well as optimisation of culture conditions using eight replicate bioreactors. Shake Flask Cultivation on INFORS Incubators with flask volumes up to 3L"@en ;
    dct:identifier "EUREMAP_008" ;
    dct:source <https://services.euremap.eu/service/euremap_008/> ;
    dct:title "Aerobic microbial biomass production using automated bioreactors, with scale-up to 10 L"@en ;
    dcat:landingPage <https://services.euremap.eu/service/euremap_008/> ;
    foaf:page <https://www.embrc-france.fr/en/nos-services/plate-formes-technologiques/culture-and-biomass> ;
    eur:accessConditions "Since it depends on the strain, contact the service"@en ;
    eur:atPipelineStep res:step-biomass-production ;
    eur:deliveredByUnit res:unit-su-bio2mar-platform-sorbonne-universit-observatoire-oc-anologiq ;
    eur:hasAccessMode res:access-physical ;
    eur:hasCapability res:cap-bacterial-cultivation,
        res:cap-bioreactor-cultivation,
        res:cap-photobioreactor ;
    eur:hasCapacity res:capacity-EUREMAP_008-1 ;
    eur:hasFeeModel res:fee-on-request ;
    eur:listedIn res:catalogue-euremap ;
    eur:offeredThrough res:ri-embrc ;
    eur:providedBy res:org-su ;
    eur:requiresPriorContact true .

